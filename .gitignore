# Local credentials and environment-specific configuration
.env
.env.*
!.env.example
backend/credentials/
*serviceAccount*.json

# Training artifacts and downloaded data. No trailing slash on purpose: "dir/"
# only matches real directories, so a symlinked data/ or weights/ would slip
# past it and get committed.
training/data
training/weights
training/outputs
training/third_party

# Exported model artifacts. The 0.8 MB AASIST-L export is committed so a fresh
# clone serves the real model; larger exports (XLS-R is ~1.2 GB) are not.
backend/models/*
!backend/models/aasist-l-indic-v0.1.onnx
!backend/models/aasist-l-indic-v0.1.json

# Python caches and local virtual environments
__pycache__/
*.py[cod]
.pytest_cache/
.venv
node_modules
frontend/dist

# Voice-clone generation virtualenv (training/scripts/prepare_data.sh step 7)
.clone-env
