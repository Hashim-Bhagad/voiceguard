# Backend env (copy to .env)
APP_NAME=voiceguard-backend
APP_ENV=dev
HOST=0.0.0.0
PORT=8000

# mock | aasist-l-onnx
MODEL_BACKEND=mock
MODEL_DIR=./models
AASIST_L_ONNX=models/aasist-l-indic-v0.1.onnx

# Policy defaults version
POLICY_VER=p1

# CORS (RN + web dashboard in dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:19006,exp://*

# Privacy: never write raw audio to disk by default
RETAIN_RAW_AUDIO=false
LOG_LEVEL=info
