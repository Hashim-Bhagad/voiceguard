# Backend env (copy to .env)
APP_NAME=voiceguard-backend
APP_ENV=dev
HOST=0.0.0.0
PORT=8000

# mock | aasist-l-onnx
MODEL_BACKEND=mock
MODEL_DIR=./models
# Any ONNX with the waveform[batch,64600] -> spoof_logit contract works here.
# The 0.8 MB AASIST-L ships with the repo. For the far more accurate XLS-R + AASIST
# (1.2 GB, not in git), copy xlsr-aasist-indic-v0.1.onnx from the training run into
# models/ and use: AASIST_L_ONNX=models/xlsr-aasist-indic-v0.1.onnx
AASIST_L_ONNX=models/aasist-l-indic-v0.1.onnx

# Policy defaults version
POLICY_VER=p1

# CORS (RN + web dashboard in dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:19006,exp://*

# Privacy: never write raw audio to disk by default
RETAIN_RAW_AUDIO=false
LOG_LEVEL=info
